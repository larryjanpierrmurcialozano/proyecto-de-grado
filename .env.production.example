# PostgreSQL externo administrado o accesible desde el host Docker.
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=anexo_de_datos
DB_USER=docstry_app
DB_PASSWORD=1234shanyis4321
DB_SSLMODE=require

# Genera un valor aleatorio largo y privado para cada despliegue.
SECRET_KEY=replace_with_a_long_random_secret

# Si el frontend se sirve desde esta misma app, puede quedar vacío.
# Si hay otro dominio de frontend, indica sus orígenes separados por coma.
CORS_ORIGINS=

APP_PORT=8000

# Correo saliente (opcional según las funciones que se usen).
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_CUENTA=
EMAIL_PASSWORD=

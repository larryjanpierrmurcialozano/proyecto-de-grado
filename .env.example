# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=docstry_app
DB_PASSWORD=
DB_NAME=anexo_de_datos

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_this_secret

# Proxy híbrido Flask -> ASP.NET Core (vacío = Flask atiende las rutas)
CSHARP_API_URL=http://127.0.0.1:5124
CSHARP_PROXY_MODULES=
CSHARP_PROXY_SECRET=

# SMTP
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_CUENTA=
EMAIL_PASSWORD=
